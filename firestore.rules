rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_admin == true;
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.is_super_admin == true;
    }

    // A cross-brand staff directory -- lives only in this project (the one
    // guaranteed to always exist) so a super admin can see who has access to
    // what across every brand, even though each brand's actual Auth/admin
    // flag lives in its own separate project.
    match /staff/{staffId} {
      allow read, write: if isSuperAdmin();
    }

    // Small admin-editable operational settings (e.g. the current Whish
    // Money collection number) -- readable by any signed-in client so the
    // portal can show it, editable only by staff, no redeploy needed to
    // change a value.
    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // Staff activity log -- every admin action (KYC, MT5, manual client
    // creation, rebates, staff provisioning), staff-only in both directions.
    // Append-only in practice: the panel never edits or deletes an entry.
    match /admin_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin();
    }

    // Deposit requests: client submits a receipt + claimed amount; every
    // status transition after that (sent to GoogleCell for confirmation,
    // deposited, rejected) is staff-only.
    match /funding_requests/{requestId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.approved_amount == null
        && request.resource.data.resolved_by == null;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Withdrawal requests: client submits amount + destination; balance
    // deduction, sending to GoogleCell, uploading their completion receipt,
    // and rejection are all staff-only transitions.
    match /withdrawal_requests/{requestId} {
      allow get: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);
      allow list: if isAdmin() || (isSignedIn() && resource.data.uid == request.auth.uid);

      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.resolved_by == null;

      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      function isOwner() {
        return isSignedIn() && request.auth.uid == userId;
      }

      function unchanged(field) {
        return !(field in request.resource.data.diff(resource.data).affectedKeys());
      }

      allow get: if isOwner() || isAdmin();
      allow list: if isAdmin();

      // Signup: client creates their own doc, but only with safe starting
      // values -- OR an admin creates a fully-formed client doc directly
      // (any status, MT5 already set) via "Create Client Manually".
      allow create: if isAdmin() || (
        isOwner()
        && request.resource.data.uid == userId
        && (!('is_admin' in request.resource.data) || request.resource.data.is_admin == false)
        && request.resource.data.status == 'pending'
        && request.resource.data.mt5_login == null
        && request.resource.data.mt5_password == null
      );

      // Self-service updates: only two transitions are allowed, and only
      // if none of the privileged fields are touched.
      allow update: if isAdmin() || (
        isOwner() &&
        unchanged('is_admin') &&
        unchanged('mt5_login') &&
        unchanged('mt5_password') &&
        unchanged('mt5_server') &&
        unchanged('mt5_accounts') &&
        unchanged('mt5_history') &&
        unchanged('last_rebate_amount') &&
        unchanged('last_rebate_paid_at') &&
        unchanged('rebate_history') &&
        unchanged('referral_code') &&
        unchanged('referral_count') &&
        unchanged('referral_credited') &&
        unchanged('rejection_reason') &&
        unchanged('created_by') &&
        unchanged('email') &&
        unchanged('uid') &&
        (
          // Submitting or resubmitting KYC documents
          (resource.data.status in ['pending', 'pending_kyc', 'kyc_rejected'] &&
           request.resource.data.status == 'kyc_submitted') ||
          // Requesting an MT5 account once KYC is approved
          (resource.data.status == 'kyc_approved' &&
           request.resource.data.status == 'mt5_requested') ||
          // Requesting an additional (2nd/3rd) MT5 account once active
          (resource.data.status == 'active' &&
           request.resource.data.status == 'mt5_requested')
        )
      );

      allow delete: if isAdmin();
    }
  }
}
