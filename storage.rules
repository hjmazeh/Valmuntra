rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function hasMe() {
      return request.auth != null &&
        firestore.exists(/databases/(default)/documents/users/$(request.auth.uid));
    }
    function me() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }
    // Same permissions as the database rules (see firestore.rules).
    function canAnyOf(d, list) {
      return d.get('role', null) == 'super_admin' || d.get('is_super_admin', false) == true
        || (('perms' in d) && d.perms.hasAny(list))
        || (!('perms' in d) && d.get('is_admin', false) == true && list.removeAll(['staff.manage']).size() > 0)
        || (!('perms' in d) && d.get('role', null) == 'marketing' && list.hasAny(['ads.manage']));
    }
    function canAny(list) { return hasMe() && canAnyOf(me(), list); }

    // KYC documents: only the client reads them here. Staff see them
    // through the links saved on the client's record.
    match /kyc/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType == 'application/pdf'
        );
    }

    // Deposit receipts: uploaded by the client themselves.
    match /funding_receipts/{userId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == userId || canAny(['deposits.process', 'transactions.history']));

      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Withdrawal completion receipts: uploaded by staff with "Process
    // withdrawals" (GoogleCell's proof of transfer).
    match /withdrawal_receipts/{requestId}/{fileName} {
      allow read: if request.auth != null;

      allow write: if canAny(['withdrawals.process'])
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
