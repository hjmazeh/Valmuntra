rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function isAdmin() {
      return request.auth != null &&
        firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.is_admin == true;
    }

    match /kyc/{userId}/{fileName} {
      allow read: if request.auth != null && request.auth.uid == userId;

      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/.*') ||
          request.resource.contentType == 'application/pdf'
        );
    }

    // Deposit receipts: uploaded by the client themselves.
    match /funding_receipts/{userId}/{fileName} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());

      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Withdrawal completion receipts: uploaded by staff (GoogleCell's proof
    // of transfer), not owned by the client's own uid, so it needs an
    // admin check via Firestore instead of a uid match.
    match /withdrawal_receipts/{requestId}/{fileName} {
      allow read: if request.auth != null;

      allow write: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
